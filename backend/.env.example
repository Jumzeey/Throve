PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for `npm run db:push` — Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
CORS_ORIGIN=*

# Mailjet — auth emails are sent by the backend (not Supabase SMTP)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_FROM_EMAIL=noreply@throve.store
MAILJET_FROM_NAME=Throve
AUTH_REDIRECT_URL=throveapp://auth/callback
