PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for `npm run db:push` — Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
CORS_ORIGIN=*

# Mailjet — auth emails are sent by the backend (not Supabase SMTP)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_FROM_EMAIL=noreply@throve.store
MAILJET_FROM_NAME=Throve
AUTH_REDIRECT_URL=throveapp://auth/callback
# Public HTTPS base used in email CTAs (bridges to throveapp:// via /open/…)
PUBLIC_API_URL=https://throve-production.up.railway.app

# Payments — Flutterwave (https://dashboard.flutterwave.com)
# Leave FLW_SECRET_KEY empty to run simulated checkout (no real funds).
# PAYMENT_MODE=simulate|flutterwave  (default: flutterwave when secret is set, else simulate)
PAYMENT_MODE=simulate
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Optional: only needed for direct card encryption flows (not Standard Checkout links)
FLW_ENCRYPTION_KEY=
# Dashboard → Settings → Webhooks → Secret hash (sent as verif-hash)
FLW_SECRET_HASH=
# Where Flutterwave returns the buyer after pay (deep link into the app)
PAYMENT_REDIRECT_URL=throveapp://checkout/payment-return

# Google Maps / Places (https://console.cloud.google.com)
# Enable: Places API (New), Geocoding API, Maps Static API
GOOGLE_MAPS_API_KEY=
