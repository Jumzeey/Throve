EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local: http://localhost:4000  |  Store / device: Railway backend
EXPO_PUBLIC_API_URL=https://throve-production.up.railway.app
# Magic-link redirect — must match Supabase Auth → URL Configuration
EXPO_PUBLIC_AUTH_REDIRECT_URL=throveapp://auth/callback

# Android Live video A/B (native rebuild for LiveKit; Expo Go cannot run WebRTC)
# Closed testers can also switch on Set up your live → Video quality test (Android).
# In-app toggle wins over this env. Default stays legacy until A/B evidence is in.
# legacy = ~720p / VP8 / ~1.7 Mbps | test = H.264 720p30 @ 2.5 Mbps + dynacast
EXPO_PUBLIC_LIVE_VIDEO_PROFILE=legacy
