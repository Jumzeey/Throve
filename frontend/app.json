{
  "expo": {
    "name": "Throve-App",
    "slug": "Throve-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "throveapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.throve.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Throve needs camera access so you can go live and sell items.",
        "NSMicrophoneUsageDescription": "Throve needs microphone access so viewers can hear you during live selling.",
        "NSPhotoLibraryUsageDescription": "Throve needs photo library access so you can add listing and profile photos.",
        "NSPhotoLibraryAddUsageDescription": "Throve needs permission to save photos when you download or share them."
      }
    },
    "android": {
      "package": "com.throve.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "throveapp",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "throveapp",
              "host": "inbox"
            },
            {
              "scheme": "throveapp",
              "host": "checkout"
            },
            {
              "scheme": "throveapp",
              "host": "product"
            },
            {
              "scheme": "throveapp",
              "host": "live"
            },
            {
              "scheme": "throveapp",
              "host": "profile"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Throve needs photo library access so you can add listing and profile photos.",
          "cameraPermission": "Throve needs camera access so you can photograph items to sell."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
