{
  "name": "throve",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace frontend",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run dev --workspace backend",
    "dev": "npm run dev --workspace backend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "db:push": "bash scripts/push-migrations.sh",
    "db:seed": "npm run seed --workspace backend"
  }
}
